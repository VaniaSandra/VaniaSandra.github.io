---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="footer-name">{site.name}</p>
      <p class="footer-descriptor">{site.descriptor}</p>
    </div>

    <nav aria-label="Footer">
      {site.nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="footer-contact">
      <a href={site.emailHref}>{site.email}</a>
      <a href={site.linkedin} rel="me noopener noreferrer" target="_blank">
        {site.linkedinLabel}
      </a>
      <p class="footer-note">For a full CV, email me.</p>
    </div>

    <p class="footer-note">
      Based in Indonesia. Open to environmental and community project work.
    </p>
  </div>

  <div class="shell footer-bottom">
    <p>© {year} {site.name}</p>
    <p>Research, writing, data and visual communication.</p>
  </div>
</footer>
