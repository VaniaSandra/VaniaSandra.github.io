---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkFrame from '../components/WorkFrame.astro';
import { site } from '../data/site';
import { workBySlug } from '../data/work';

const getItem = (slug: string) => {
  const item = workBySlug.get(slug);
  if (!item) throw new Error(`Missing work item: ${slug}`);
  return item;
};

const scada = getItem('scada-agtech-climate-adaptation');
const soil = getItem('soil-organic-carbon');
const tableau = getItem('food-production-emissions');
const fcc = getItem('fcc-blue-economy');

const strip = [
  { item: scada, image: scada.images[3], caption: 'SCADA 2026 · delivery pathway' },
  { item: soil, image: soil.images[2], caption: 'Soil carbon essay · index' },
  { item: tableau, image: tableau.images[2], caption: 'Food emissions · supply chain' },
  { item: fcc, image: fcc.images[0], caption: 'FCC webinar · public poster' },
];

const roles = [
  'Environmental project officer',
  'Sustainability project officer',
  'Project or programme coordinator',
  'Project assistant',
  'Research support',
  'Junior project management, where the scope fits',
];
---

<BaseLayout
  title="Contact · Vania Sandra Clarissa"
  description="Contact Vania Sandra Clarissa about environmental and community project officer, coordinator and research support roles."
>
  <header class="page-head contact-head">
    <div class="shell contact-hero">
      <h1 class="contact-title"><span>Get in</span><span>touch</span></h1>
      <div class="contact-intro">
        <p class="lead">
          For project officer, coordinator and research support roles, get in touch.
        </p>
        <p>
          I am based in Indonesia and open to work on environmental, agricultural and community
          projects. Email is the best first contact.
        </p>
      </div>
    </div>
  </header>

  <section class="section contact-main" aria-labelledby="contact-details-title">
    <div class="shell contact-page-grid">
      <div class="contact-panel" data-reveal>
        <h2 id="contact-details-title">Reach me directly</h2>
        <div class="contact-direct">
          <a class="contact-email" href={site.emailHref}>{site.email}</a>
          <a class="contact-social" href={site.linkedin} rel="me noopener noreferrer" target="_blank">
            LinkedIn <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <p class="contact-cv">For a full CV, email me.</p>
        <p class="contact-place">Based in Indonesia.</p>
      </div>

      <div class="contact-body">
        <div class="contact-block" data-reveal>
          <h2>What I am looking for</h2>
          <ul class="role-list">
            {roles.map((role) => (
              <li>{role}</li>
            ))}
          </ul>
        </div>

        <div class="contact-block" data-reveal>
          <h2>Current focus</h2>
          <p>
            Sustainable agriculture, soil health, climate adaptation, community-led work, and blue
            economy and fisheries. My recent study and writing sit in these areas; my professional
            delivery experience comes from medical physics projects.
          </p>
        </div>

        <div class="contact-block" data-reveal>
          <h2>How I work</h2>
          <p>
            I start from the constraint, keep the evidence visible, and write things down so the next
            person can follow. I am comfortable working across technical, clinical, commercial and
            community stakeholders, in Indonesian and English.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ivory" aria-labelledby="contact-work-title">
    <div class="shell">
      <div class="gallery-head" data-reveal>
        <h2 id="contact-work-title">Some work to start with</h2>
        <a class="text-action" href="/work/">
          See all work <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="contact-strip">
        {strip.map((entry) => (
          <a
            class="strip-link"
            href={`/work/${entry.item.slug}/`}
            aria-label={`View ${entry.item.title}`}
            data-reveal
          >
            <WorkFrame image={entry.image} caption={entry.caption} tone="clay" frameHeight={180} />
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
